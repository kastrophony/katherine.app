{
  "name": "katherine-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@12.15.0"
}
